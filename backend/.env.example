# ---- LLM ----
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4.1"
OPENAI_TEMPERATURE=0.3

# ---- Tool APIs ----
AVIATIONSTACK_API_KEY="your_aviationstack_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"

# ---- Database ----
# Conversation threads are checkpointed here, so they survive a restart.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ---- Observability (LangSmith) ----
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
# Use a separate project per environment, e.g. voyanta-dev / voyanta-prod.
LANGSMITH_PROJECT="voyanta-dev"

# ---- App ----
ENVIRONMENT="dev"          # dev | staging | prod
APP_VERSION="0.1.0"
LOG_LEVEL="INFO"

# Comma-separated origins allowed to call the API (your Next.js dev server).
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Per-IP limit on the chat endpoints. LLM calls cost money — keep this on.
CHAT_RATE_LIMIT="20/minute"

# ---- Billing (Stripe) ----
# All three or none. Leave them blank and quotas are still counted but never enforced,
# so a deployment without Stripe is not a deployment where everyone hits a paywall.
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET="whsec_your_signing_secret_here"
# The recurring price the Pro plan subscribes to (price_..., not prod_...).
STRIPE_PRICE_ID="price_your_price_id_here"

# Where Stripe returns the browser after checkout — a frontend URL, not this API.
BILLING_RETURN_URL="http://localhost:3000/chat"

# One turn = one message and its reply. Roughly $0.02–0.05 of model and search spend.
FREE_TURNS_PER_MONTH=20
# A fair-use ceiling, not a meter anyone should notice.
PRO_TURNS_PER_MONTH=500
PRO_PRICE_LABEL="$15/month"

# ---- Agent guardrails ----
RECURSION_LIMIT=25
REQUEST_TIMEOUT=60
MAX_RETRIES=2
